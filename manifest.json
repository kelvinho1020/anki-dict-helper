{
	"manifest_version": 3,
	"name": "Anki 單字助手",
	"version": "1.0.0",
	"description": "選取英文單字，看繁體中文解釋，一鍵加入 AnkiWeb。",
	"minimum_chrome_version": "116",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": ["storage", "offscreen"],
	"host_permissions": [
		"https://dictionary.cambridge.org/*",
		"https://translate.googleapis.com/*",
		"https://api.mymemory.translated.net/*",
		"https://ankiuser.net/*",
		"https://ankiweb.net/*"
	],
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["dictionary.js", "content.js"],
			"run_at": "document_idle",
			"all_frames": true
		}
	]
}
